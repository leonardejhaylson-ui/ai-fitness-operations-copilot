# Supabase Auth configuration used server-side by App Router actions/middleware.
# The anon key is publishable by design, but this MVP does not need a browser Supabase client.
# Never expose the service-role key through a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only LLM gateway credential. No integration is implemented yet.
OPENAI_API_KEY=

# Optional server-only model override. Defaults to gpt-5.6-luna.
OPENAI_MODEL=
